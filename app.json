{
  "expo": {
    "name": "NullSec",
    "slug": "nullsec",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nullsec",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05090d",
    "primaryColor": "#3fd6e8",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nullsec.app"
    },
    "android": {
      "package": "com.nullsec.app",
      "adaptiveIcon": {
        "backgroundColor": "#0c1116",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05090d"
        }
      ]
    ],
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/08503c9c-9862-4943-b488-38c8321758cf"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "08503c9c-9862-4943-b488-38c8321758cf"
      }
    },
    "owner": "vinxo"
  }
}
