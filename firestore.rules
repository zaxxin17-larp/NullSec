rules_version = '2';

// NullSec Firestore security rules.
//   * A user may only read/write their own profile document at users/{uid}.
//   * Profile writes are shape-validated so a client cannot store arbitrary data.
//   * Everything else is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function profileFields() {
      return ['username', 'email', 'acceptedTerms', 'acceptedTermsAt', 'createdAt'];
    }

    function validUsername(v) {
      return v is string && v.size() >= 3 && v.size() <= 32;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(profileFields())
        && validUsername(request.resource.data.username)
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.acceptedTerms == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.acceptedTermsAt == request.time;

      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(profileFields())
        && validUsername(request.resource.data.username)
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isOwner(uid);
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
