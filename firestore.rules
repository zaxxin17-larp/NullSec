rules_version = '2';

// NullSec Firestore security rules.
//   * A user may only read/write their own profile document at users/{uid}.
//   * Profile writes are shape-validated so a client cannot store arbitrary data.
//   * Everything else is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // An admin is a member whose directory document has role == 'admin'. The
    // role is forced to 'student' on create and cannot be changed by the client,
    // so it can only be set from the console / admin SDK.
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin';
    }

    function profileFields() {
      return ['username', 'email', 'acceptedTerms', 'acceptedTermsAt', 'createdAt'];
    }

    function validUsername(v) {
      return v is string && v.size() >= 3 && v.size() <= 32;
    }

    // Calendar events live under users/{uid}/events/{eventId}.
    function eventFields() {
      return ['title', 'date', 'notes', 'createdAt'];
    }

    function validEvent(data) {
      return data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.notes is string
        && data.notes.size() <= 1000;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(profileFields())
        && validUsername(request.resource.data.username)
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.acceptedTerms == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.acceptedTermsAt == request.time;

      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(profileFields())
        && validUsername(request.resource.data.username)
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isOwner(uid);

      match /events/{eventId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(eventFields())
          && validEvent(request.resource.data)
          && request.resource.data.createdAt == request.time;

        allow delete: if isOwner(uid);
      }
    }

    // Public class directory: members/{uid}. Name plus optional custom profile
    // (avatar link, accent colour, status) — no email — readable by any
    // signed-in classmate.
    function memberFields() {
      return ['uid', 'username', 'role', 'createdAt', 'avatarUrl', 'accent', 'bio'];
    }

    function hasKey(data, key) {
      return data.keys().hasAny([key]);
    }

    // The custom profile fields are optional so older documents (created before
    // they existed) can still be updated by name alone.
    function validProfile(data) {
      return (!hasKey(data, 'avatarUrl')
          || data.avatarUrl == ''
          || (data.avatarUrl is string
              && data.avatarUrl.size() <= 500
              && data.avatarUrl.matches('^https://.*')))
        && (!hasKey(data, 'accent')
          || data.accent == ''
          || (data.accent is string && data.accent.matches('^#[0-9a-fA-F]{6}$')))
        && (!hasKey(data, 'bio')
          || (data.bio is string && data.bio.size() <= 120));
    }

    match /members/{uid} {
      allow read: if request.auth != null;

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(memberFields())
        && request.resource.data.uid == uid
        && validUsername(request.resource.data.username)
        && request.resource.data.role == 'student'
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(memberFields())
        && request.resource.data.uid == uid
        && validUsername(request.resource.data.username)
        && request.resource.data.role == resource.data.role
        && validProfile(request.resource.data);

      allow delete: if isOwner(uid);
    }

    // Shared class attendance: classes/main/days/{date}. Each day holds a
    // `marks` map of uid -> status. Readable by any signed-in classmate, but
    // only an admin may write.
    function validAttendanceDay(data, date) {
      return data.date == date
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.marks is map
        && data.marks.size() <= 500
        && data.updatedBy == request.auth.uid;
    }

    match /classes/main/days/{date} {
      allow read: if request.auth != null;

      allow create, update: if isAdmin()
        && validAttendanceDay(request.resource.data, date);

      allow delete: if false;
    }

    // Class announcements: announcements/{id}. Readable by any signed-in
    // classmate; only an admin may post or delete.
    function announcementFields() {
      return ['title', 'body', 'authorUid', 'authorName', 'createdAt'];
    }

    function validAnnouncement(data) {
      return data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.body is string
        && data.body.size() <= 2000
        && data.authorUid == request.auth.uid
        && data.authorName is string
        && data.authorName.size() <= 120;
    }

    match /announcements/{id} {
      allow read: if request.auth != null;

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(announcementFields())
        && validAnnouncement(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow delete: if isAdmin();
    }

    // Class group chat: messages/{id}. Readable and writable by any signed-in
    // classmate; a message may be deleted by its author or an admin.
    function messageFields() {
      return ['text', 'authorUid', 'authorName', 'createdAt'];
    }

    function validMessage(data) {
      return data.text is string
        && data.text.size() >= 1
        && data.text.size() <= 2000
        && data.authorUid == request.auth.uid
        && data.authorName is string
        && data.authorName.size() <= 120;
    }

    match /messages/{id} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(messageFields())
        && validMessage(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow delete: if request.auth != null
        && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
